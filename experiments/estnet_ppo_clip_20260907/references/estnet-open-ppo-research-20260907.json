  "semantics": {
    "ppo_clip": "裁剪的是surrogate objective中的概率比，取min形式；不是动作裁剪、参数硬边界或每个样本ratio的强制上限。",
    "value_clip": "被审上游默认True：以旧value为中心，对差值用同一clip_param裁剪后，与未裁剪平方误差取较大值；不把最终V输出硬限于该范围。",
    "adaptive_kl": {
      "condition": "schedule == adaptive and desired_kl is not None",
      "above_2x": "lr=max(1e-5,lr/1.5)",
      "between_0_and_half": "lr=min(1e-2,lr*1.5)",
      "otherwise": "unchanged",
      "then": "继续本minibatch正常backward/optimizer.step",
      "hard_limit": false
    },
    "kl_early_stop_or_rollback": "已人工阅读四个版本的PPO.update：v1.0.2、v2.1.1、v5.0.1和当前5.5；这些实现没有基于KL的break、更新拒绝或模型+Adam回滚。此结论仅指列明提交，不泛指所有PPO实现。",
    "grad_norm": "v1.0.2/v2.1.1对actor_critic合并参数裁剪；v5.0.1/当前5.5分别裁剪actor和critic。数值都为1但作用参数集合不同，不能只看数字声称等价。"
  },
